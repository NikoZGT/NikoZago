# Bot Configuration
INITIAL_CAPITAL=10
POSITION_SIZE_PERCENT=2.5
MAX_CONCURRENT_POSITIONS=3
WEEKLY_GROWTH_TARGET=3.5

# Network Configuration (solana, bsc, base)
NETWORK=solana

# Solana Configuration
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_WALLET_PRIVATE_KEY=your_private_key_here

# BSC Configuration
BSC_RPC_URL=https://bsc-dataseed.binance.org
BSC_WALLET_PRIVATE_KEY=your_private_key_here

# Base Configuration
BASE_RPC_URL=https://mainnet.base.org
BASE_WALLET_PRIVATE_KEY=your_private_key_here

# API Keys
DEXTOOLS_API_KEY=your_dextools_api_key
TWITTER_BEARER_TOKEN=your_twitter_bearer_token
RUGCHECK_API_KEY=your_rugcheck_api_key

# Risk Management
STOP_LOSS_PERCENT=8
TAKE_PROFIT_PERCENT=40
TRAILING_STOP_PERCENT=10
MAX_CONSECUTIVE_LOSSES=2

# Trading Parameters
MIN_LIQUIDITY=25000
MAX_TX_FEE_PERCENT=2
MIN_VOLUME_24H=2000
MIN_VOLUME_12H=1000
VOLUME_DROP_THRESHOLD=25

# Security Filters
MIN_LP_LOCKED_PERCENT=80
MAX_TOP_HOLDERS_PERCENT=35
MAX_CONTRACT_TAX=10

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true
