{
  "name": "memecoin-trading-bot",
  "version": "1.0.0",
  "description": "AI-powered memecoin trading bot for minute trades with $10 initial capital",
  "main": "dist/bot.js",
  "scripts": {
    "start": "node dist/bot.js",
    "start:advanced": "node dist/bot-advanced.js",
    "dev": "ts-node src/bot.ts",
    "dev:advanced": "ts-node src/bot-advanced.ts",
    "backtest": "ts-node src/backtesting/run-backtest.ts",
    "build": "tsc",
    "test": "jest",
